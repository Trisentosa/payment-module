SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=paygate
DB_USER=paygate_user
DB_PASSWORD=secret
DB_MAX_CONNECTIONS=10

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

RABBITMQ_URL=amqp://guest:guest@localhost:5672/paygate

# Sandbox dashboard → Settings → Access Keys → General credentials (not BI SNAP).
MIDTRANS_SERVER_KEY=your-sandbox-key
# Only the sandbox drill (make sandbox) uses the client key, to tokenize test cards.
# MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_ENV=sandbox
# MIDTRANS_BASE_URL overrides the URL MIDTRANS_ENV picks, e.g. to point at a stand-in.
# MIDTRANS_TIMEOUT_MS=30000
# MIDTRANS_NOTIFICATION_URL sends payment notifications here instead of the URL set in the
# Midtrans dashboard, e.g. https://<tunnel>/webhooks/midtrans for local sandbox testing.

# Who issues QRIS codes and settles them: gopay (default) or "airpay shopee". Customers
# can pay with any QRIS app either way.
# MIDTRANS_QRIS_ACQUIRER=gopay

# Reconciler timing (Go durations). RECONCILE_CHARGE_GRACE must exceed MIDTRANS_TIMEOUT_MS.
# RECONCILE_INTERVAL=1m
# RECONCILE_CHARGE_GRACE=2m

LOG_LEVEL=info
LOG_FORMAT=text

# Ops key for /api/v1/admin/* (X-Admin-Key header). Required, at least 32 characters.
ADMIN_API_KEY=local-dev-admin-key-change-me-0000

# Services allowed to call /payments, as service:sha256(api key), comma-separated.
# Required. Issue a real key with: go run ./cmd/apikey <service-name>
# This local-only entry is for the key "pgk_local-dev-only-do-not-use-in-prod":
#   curl -H "Authorization: Bearer pgk_local-dev-only-do-not-use-in-prod" localhost:8080/payments
CALLER_API_KEYS=local-dev:e59a82f896117958383f86bf6300ec7d7fd483dadf208ffb49b7cf06b7f0d9d0
